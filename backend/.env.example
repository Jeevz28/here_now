PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=herenow
DEMO_MODE=false
# Allowed browser/native Origin values, comma separated. Verify actual client Origin before restricting.
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8085

# Real Android push delivery. Keep the private service account ONLY on Railway/backend.
PUSH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# Leave empty unless you have verified the reverse-proxy source CIDRs. Never use true or a blanket hop count.
TRUST_PROXY_CIDRS=
